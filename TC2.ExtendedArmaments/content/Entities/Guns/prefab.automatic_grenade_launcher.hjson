$name: "Automatic Grenade Launcher"
$desc:
	'''
	An automatic grenade launcher.
	Lobs large grenades.
	'''
$tags: []

body:
{
	buoyancy: 0.120

	@shape.line:
	{
		a: [-1.250, 0.150]
		b: [1.250, -0.050]
		mass: 60.000
		radius: 0.350
		friction: 0.900
		elasticity: 0.250
		material: metal
		layer: entity, solid, ignore_bullet, ignore_melee, item
		mask: world
	}
}

gun:
{
	muzzle_offset: [1.750, 0.000]
	receiver_offset: [-0.500, 0.000]

	sound_shoot: "shotgun_shoot"
	sound_reload: "machine_gun_reload"
	velocity_multiplier: 280.000
	jitter_multiplier: 5.000
	damage_multiplier: 2.000
	recoil_multiplier: 1.500
	reload_interval: 4.000
	cycle_interval: 0.300
	failure_rate: 0.001
	max_ammo: 20.000
	flags: automatic, full_reload, cycle_on_shoot
	ammo_filter: ammo_grenade
	action: blowback
	type: launcher
	feed: drum

	heuristic_range: 15.000

	shake_amount: 0.400
	stability: 3500.000
	
	@inventory1:
	{
		name: "Ammo"
		stack_size_multiplier: 1.000
		type: ammo
		flags: hidden, ignore_mass
	}
	
	@light:
	{
		color: [1.000, 0.400, 0.100, 2.000]
		offset: [1.000, -0.250]
		scale: [28.000, 20.000]
		intensity: 0.000
		texture: "light.circle.00"
	}
}

gun.state:
{

}

holdable:
{
	offset: [-1.000, 0.000]
	radius: 2.000
	flags: full_rotate

	force_multiplier: 0.500
	torque_multiplier: 0.300
}

attachment:
{
	offset: [-0.375, 0.000]
}

animated.renderer:
{
	sprite:
	{
		texture: "automatic_grenade_launcher"
	}
}

health:
{
	max: 8000.000
}

armor:
{
	toughness: 150.000
	protection: 0.900
	
	knockback_modifier: 1.300
	pain_modifier: 0.000

	material_type: metal
	flags: no_damage_type_conversion
}

transform:
{

}

packable:
{

}

control:
{

}

aimable:
{

}

overheat:
{
	heat_medium: 350.000
	heat_high: 600.000
	heat_critical: 850.000
	cool_rate: 45.000

	offset: [0.750, 0.000]
	size: [0.750, 0.250]
	
	@light:
	{
		color: [1.000, 0.400, 0.100, 2.000]
		offset: [0.875, 0.000]
		scale: [6.000, 2.000]
		intensity: 0.000
		texture: "light.box.00"
	}
	
	@sound.emitter:
	{
		file: "overheat_loop"
		volume: 0.000
		pitch: 1.000
	}
}