$name: "Revolving Grenade Launcher"
$desc:
	'''
	A revolving grenade launcher.
	Lobs large grenades.
	'''
$tags: []

body:
{
	buoyancy: 0.100

	@shape.line:
	{
		a: [-0.900, 0.170]
		b: [0.900, 0.000]
		mass: 18.000
		radius: 0.250
		friction: 0.900
		elasticity: 0.250
		material: metal
		layer: entity, solid, ignore_bullet, ignore_melee, item
		mask: world
	}
}

gun:
{
	muzzle_offset: [1.250, -0.125]
	receiver_offset: [-0.250, 0.000]

	sound_shoot: "shotgun_shoot"
	sound_cycle: "revolver_cycle"
	sound_reload: "revolver_reload"
	velocity_multiplier: 280.000
	jitter_multiplier: 2.000
	damage_multiplier: 2.000
	recoil_multiplier: 1.500
	reload_interval: 1.000
	cycle_interval: 0.750
	failure_rate: 0.001
	max_ammo: 6.000
	flags: none
	ammo_filter: ammo_grenade
	action: revolver
	type: launcher
	feed: cylinder

	heuristic_range: 15.000

	shake_amount: 0.350
	stability: 1150.000
	
	@inventory1:
	{
		name: "Ammo"
		stack_size_multiplier: 1.000
		type: ammo
		flags: hidden, ignore_mass
	}
	
	@light:
	{
		color: [1.000, 0.400, 0.100, 2.000]
		offset: [1.000, -0.250]
		scale: [28.000, 20.000]
		intensity: 0.000
		texture: "light.circle.00"
	}
}

gun.state:
{

}

holdable:
{
	offset: [-0.400, 0.000]
	radius: 4.000
	flags: storable
	hints: gun, powerful, inaccurate

	force_multiplier: 1.100
	torque_multiplier: 1.600
}

animated.renderer:
{
	sprite:
	{
		texture: "revolving_grenade_launcher"
	}
}

health:
{
	max: 5000.000
}

transform:
{

}

packable:
{

}

control:
{

}

aimable:
{
	min: -0.800
	max: 0.650
}