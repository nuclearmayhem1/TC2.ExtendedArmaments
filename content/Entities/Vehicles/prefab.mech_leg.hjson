$name: "Actuated Leg"
$desc:
	'''
	A robotic leg for movement.
	'''
$tags: []

body:
{
	inventory_weight_multiplier: 0.150
	
	@shape.box:
	{
		size: [1.000, 1.000]
		offset: [0.000, 0.000]
		mass: 500.000
		friction: 0.750
		elasticity: 0.400
		material: metal
		layer: entity, solid
		mask: world
	}
}

health:
{
	max: 25000.000
}

holdable:
{
	force_multiplier: 2.000
	torque_multiplier: 1.000
	
	radius: 0.000
	flags: disable_parent_facing
}

attachment:
{
	force_multiplier: 5.000
	torque_multiplier: 5.000
	offset: [0.000, 1.000]
	flags: disable_parent_facing
	tags: none
}

animated.renderer:
{
	sprite:
	{
		texture: "mech_leg_base"
	}
	z: -100
}

transform:
{

}

control:
{

}

